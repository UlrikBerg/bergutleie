{
  "name": "bergutleie",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nettsted for Berg Utleie – bergutleie.no",
  "scripts": {
    "bygg": "node bygg.js",
    "start": "node bygg.js && node --run server",
    "server": "node --experimental-strip-types -e \"import('node:http').then(async({default:h})=>{const{readFile,stat}=await import('node:fs/promises');const{join,extname}=await import('node:path');const T={'.html':'text/html; charset=utf-8','.css':'text/css','.js':'text/javascript','.png':'image/png','.jpg':'image/jpeg','.webp':'image/webp','.xml':'application/xml','.txt':'text/plain'};h.createServer(async(q,s)=>{let p=join('dist',decodeURIComponent(q.url.split('?')[0]));try{if((await stat(p)).isDirectory())p=join(p,'index.html')}catch{p=join('dist','404.html')};try{const b=await readFile(p);s.writeHead(200,{'content-type':T[extname(p)]||'application/octet-stream','cache-control':'no-store'});s.end(b)}catch{s.writeHead(404);s.end('404')}}).listen(8899,()=>console.log('http://localhost:8899'))})\""
  }
}
